{
  "name": "vibent-chatbot",
  "version": "1.0.0",
  "description": "An AI-powered entertainment chatbot with movie suggestions, event booking, trip planning, and mood-based experiences",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:oauth": "jest tests/oauth-tests.js",
    "test:flows": "jest tests/flow-tests.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "keywords": [
    "chatbot",
    "entertainment",
    "movies",
    "events",
    "trip-planner",
    "ai",
    "oauth2",
    "tmdb",
    "eventbrite",
    "spotify",
    "amadeus"
  ],
  "author": "Darshan",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "oauth2-server": "^3.1.1",
    "jsonwebtoken": "^9.1.0",
    "express-session": "^1.17.3",
    "node-cache": "^5.1.2",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "openai": "^4.23.0",
    "db-client": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "jest-mock-axios": "^4.6.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
