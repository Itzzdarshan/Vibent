# ============================================
# VIBENT - Entertainment Chatbot Environment
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your_secret_session_key_here_change_in_production

# TMDB Movies API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Eventbrite Events API
EVENTBRITE_API_KEY=your_eventbrite_api_key_here
EVENTBRITE_CLIENT_ID=your_eventbrite_client_id
EVENTBRITE_CLIENT_SECRET=your_eventbrite_client_secret
EVENTBRITE_BASE_URL=https://www.eventbriteapi.com/v3

# Amadeus Travel API
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Spotify Playlists API
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback
SPOTIFY_BASE_URL=https://api.spotify.com/v1

# OAuth Configuration
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_AUTHORIZATION_ENDPOINT=http://localhost:3000/oauth/authorize
OAUTH_TOKEN_ENDPOINT=http://localhost:3000/oauth/token

# AI/LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=vibent_db
DB_URL=postgresql://postgres:password@localhost:5432/vibent_db

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_TIMEOUT=1800000
SESSION_MAX_AGE=1800000

# API Timeout (in milliseconds)
API_TIMEOUT=5000

# Feature Flags
ENABLE_TRIP_PLANNER=true
ENABLE_EVENT_PLANNER=true
ENABLE_ENTERTAINMENT_GENIE=true
ENABLE_OAUTH=true

# Monitoring & Analytics
ENABLE_ANALYTICS=true
ANALYTICS_ENDPOINT=https://analytics.vibent.dev

# Error Reporting
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
